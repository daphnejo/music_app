# MongoDB Atlas ulanish satri (Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/solfedjio?retryWrites=true&w=majority

# JWT
JWT_SECRET=juda-uzun-tasodifiy-satr-shu-yerga
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Vercel frontend manzili(lari), vergul bilan ajratilgan
CORS_ORIGINS=https://solfedjio.vercel.app,http://localhost:5173

PORT=3000
NODE_ENV=production

# Login rate limit
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SECONDS=300

# Media (imzolangan URL) TTL
MEDIA_TOKEN_TTL_SECONDS=3600

# Cloudflare R2 (S3-mos)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=solfedjio-media
R2_PUBLIC_BASE_URL=https://media.solfedjio.example
