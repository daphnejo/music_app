{
  "name": "solfedjio-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Solfedjio, 1-sinf — backend (Express + MongoDB Atlas + JWT), Render uchun",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "content:import": "node --experimental-strip-types src/tools/import-content.ts",
    "media:upload": "node tools/upload-media-to-r2.mjs",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "cookie-parser": "^1.4.6",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
