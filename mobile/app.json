{
  "expo": {
    "name": "D-Solfedjio",
    "slug": "solfedjio-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "solfedjio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./.generated/icon.png",
    "splash": { "image": "./.generated/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#FFF9F2" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "uz.artclub.solfedjio", "config": { "usesNonExemptEncryption": false } },
    "android": {
      "package": "uz.artclub.solfedjio",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": { "foregroundImage": "./.generated/adaptive-icon.png", "backgroundColor": "#FFF9F2" },
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-audio", { "recordAudioAndroid": false, "microphonePermission": false }],
      "expo-video",
      "expo-font",
      "expo-asset",
      "react-native-audio-api"
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "router": {}, "eas": { "projectId": "d35794d4-5fb0-4bdf-995b-48476c26afc9" } },
    "owner": "anvar_1802"
  }
}
