{
  "expo": {
    "name": "Solfedjio",
    "slug": "solfedjio-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "solfedjio",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.artclub.solfedjio",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": { "package": "uz.artclub.solfedjio", "edgeToEdgeEnabled": true },
    "plugins": ["expo-router", "expo-secure-store", "expo-audio", "expo-video"],
    "experiments": { "typedRoutes": true }
  }
}
